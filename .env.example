APP_NAME=Getfy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# URL pública (HTTPS) para montar postbacks quando APP_URL é local ou HTTP. Instalação Docker: perguntada no install.sh / gravada em .docker/stack.env como GETFY_WEBHOOK_PUBLIC_URL.
# GETFY_WEBHOOK_PUBLIC_URL=http://getfy-gateway.test

# Indica se a aplicação foi instalada (true após wizard ou instalação manual)
APP_INSTALLED=false

# Se true, ao ocorrer erro de tabela/view inexistente (ex.: migration faltando), executa php artisan migrate automaticamente e redireciona
# Recomendado apenas em desenvolvimento/local. Em produção use false.
APP_AUTO_MIGRATE=false

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# MySQL/MariaDB (ex.: Laragon nativo ou docker-compose.yml com serviço mysql)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=getfy
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL — Docker Compose publica no HOST em 5433 (ex.: localhost:5433).
# Dentro da rede Docker use sempre: GETFY_DB_HOST=postgres e GETFY_DB_PORT=5432.
# NÃO use DB_PORT=5433 nos containers (app/worker/scheduler) — gera Connection refused.
# DB_URL vazio para não sobrescrever host/porta.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=getfy
DB_USERNAME=getfy
DB_PASSWORD=getfy
# Em VPS/Docker (stack.env / compose):
# GETFY_DB_HOST=postgres
# GETFY_DB_PORT=5432
# DB_URL=

# Aviso (Postgres + migrate:fresh): parte da cadeia de migrações que converte
# products.id para UUID roda apenas em mysql/mariadb. Um banco Postgres criado
# só com migrate pode ficar incompatível com app/Models/Product (UUID). Para
# dados vindos do MySQL, use ferramenta de migração/cópia; não basta trocar o .env.
GETFY_DEMO_MODE=false
GETFY_DEMO_ADMIN_EMAIL=admin@dev.com
GETFY_DEMO_SELLER_EMAIL=info@dev.com

# Ferramenta oculta: /plataforma/ops/mercadopago-saldo (requer platform_admin)
GETFY_MP_BALANCE_TOOL_ENABLED=false
# Sessão
SESSION_DRIVER=database
# SESSION_DRIVER=redis
# SESSION_STORE=redis
# Duração em minutos (mínimo 120). 10080 = 7 dias, 43200 = 30 dias
# Sessão / cookies (login intermitente em produção)
# - SESSION_DOMAIN=null com áreas de membros em domínio custom (nunca .dominio.com se houver custom hosts)
# - SESSION_SECURE_COOKIE=true somente com HTTPS real para o usuário
# - Preferir SESSION_COOKIE estável (não mudar com APP_NAME após deploy)
# - TRUSTED_PROXIES correto atrás de Caddy/Cloudflare
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
# Deixe null para o domínio atual. NÃO use .seudominio.com se existirem domínios custom de membros.
SESSION_DOMAIN=null
# Nome estável do cookie (opcional; evita órfãos ao mudar APP_NAME)
# SESSION_COOKIE=getfy-session
# Cookie Secure: true | false | (vazio = detecta pelo request; use true só com HTTPS real)
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# Proxies confiáveis (load balancer / Cloudflare). Em produção informe IPs separados por vírgula.
# TRUSTED_PROXIES=*

# Instalador web (desabilitar em produção Docker; use install.sh)
# Após instalação em produção, desabilite o instalador web:
# INSTALLER_ENABLED=false
# Durante a instalação, defina um token forte (header X-Installer-Token ou ?installer_token=):
# INSTALLER_TOKEN=gerar-token-forte
# Primeiro admin só via registro público se explicitamente habilitado (prefira: php artisan getfy:create-dev-admin)
# CREATE_FIRST_ADMIN=false

# CORS do proxy SDK CajuPay (além de APP_URL)
# CHECKOUT_CORS_ORIGINS=https://checkout.seudominio.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Telegram — fila coberta por worker-webhooks-in (não apontar para fila sem worker).
TELEGRAM_QUEUE=webhooks-inbound
# Vendas públicas Telegram: manter false até autorização expressa.
TELEGRAM_PRODUCT_SALES_OPERATIONAL=false

# Redis de filas (separado do cache). Em Docker: serviço redis-queue (AOF + noeviction).
# REDIS_QUEUE_HOST=redis-queue
# REDIS_QUEUE_PORT=6379
REDIS_QUEUE_CONNECTION=queue
# Deve ser > timeout do worker (120s). Default 180.
REDIS_QUEUE_RETRY_AFTER=180

# Meta Pixel CAPI — fila dedicada (worker: queue:work --queue=meta-tracking)
META_TRACKING_QUEUE=meta-tracking
META_TRACKING_DEBUG=false

# Utmify — fila dedicada (worker: queue:work --queue=utmify-tracking)
UTMIFY_QUEUE=utmify-tracking
UTMIFY_DEBUG=false

# Métricas internas — geo via Cloudflare na captura; job ip-api na fila metrics-tracking
# METRICS_TRACKING_ENABLED=true
# METRICS_TRACKING_QUEUE=metrics-tracking
# METRICS_GEO_PROVIDER=ip_api

REDIS_CACHE_CONNECTION=cache

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — com docker-compose.local-db.yml o serviço expõe 6379 no host por padrão.
# Se mudar LOCALDB_REDIS_PORT no compose, ajuste REDIS_PORT aqui.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379



VITE_APP_NAME="${APP_NAME}"

# CajuPay (PIX): chaves no painel Integrações → Gateways (X-API-Key / X-API-Secret). Opcional:
# CAJUPAY_API_BASE_URL=https://api.cajupay.com.br

# Pagar.me API v5 (opcional): mesma URL para teste/produção; credenciais ficam no painel Integrações → Gateways
# PAGARME_API_BASE_URL=https://api.pagar.me/core/v5

# Assinaturas: dias após o fim do período (current_period_end) em atraso antes de cancelar automaticamente (comando subscriptions:expire-due)
# GETFY_SUBSCRIPTION_CANCEL_GRACE_DAYS=14

PLUGIN_STORE_URL=https://getfy.store

# Modo demonstração (read-only global). Para desativar: false + php artisan config:clear
# GETFY_DEMO_MODE=false
# GETFY_DEMO_ADMIN_EMAIL=demo-admin@seudominio.com
# GETFY_DEMO_SELLER_EMAIL=demo-vendedor@seudominio.com

# PWA: notificações push do painel (recomendado: configurar em Plataforma → App → Notificações push)
# Legado VAPID via .env (fallback se não houver config no admin):
# PWA_PUSH_PROVIDER=vapid
# PWA_VAPID_PUBLIC=
# PWA_VAPID_PRIVATE=
# Firebase (alternativa; preferir painel admin):
# PWA_PUSH_PROVIDER=fcm
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_WEB_VAPID_KEY=

# ---------------------------------------------------------------------------
# Stacker (licença + agente + updates remotos)
# ---------------------------------------------------------------------------
STACKER_API_URL=https://api.stacker.builders
STACKER_AGENT_TOKEN=
# Mesma chave do backend Stacker (api.stacker.builders) — valida assinatura da licença
STACKER_RELEASE_SIGNING_KEY=
STACKER_SUPPORT_WHATSAPP=
# Updates legados via Git público (compatibilidade temporária no install)
# GETFY_LEGACY_GIT_UPDATE=1

